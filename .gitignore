# Public production binaries are versioned by deploy/manifests/public-assets.v1.json
# and stored in COS/CDN or the server shared asset directory. JSON/text manifests
# in the same directories remain trackable because application builds import them.
public/**/*.png
public/**/*.jpg
public/**/*.jpeg
public/**/*.webp
public/**/*.gif
public/**/*.ico
public/**/*.mp3
public/**/*.wav
public/**/*.ogg
public/**/*.m4a
public/**/*.aac
public/**/*.flac
public/**/*.pdf
public/**/*.zip

# Release-coupled lightweight previews/icons that are directly imported by
# prerendered pages must ship with the source snapshot; large generated media
# still belongs to deploy/manifests/public-assets.v1.json and external storage.
!public/short-drama/previews/*.webp
!public/product-assets/youcai-demo-v1/clean-v21/previews/*.webp
!public/brand/platform-logo-display-256.webp

