{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zimeiti.local/contracts/release-targeted-regression-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scopeReceiptId", "scopeReceiptSha256", "subjectCommit", "classification", "changedFiles", "executions", "result"],
  "properties": {
    "schemaVersion": {"const": "zimeiti-release-targeted-regression-receipt.v1"},
    "scopeReceiptId": {"type": "string", "pattern": "^scope-[a-f0-9]{24}$"},
    "scopeReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subjectCommit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "classification": {"const": "FAST"},
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "regressionIds"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "regressionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regressionId", "executable", "args", "exitCode"],
        "properties": {
          "regressionId": {"type": "string", "minLength": 1},
          "executable": {"type": "string", "minLength": 1},
          "args": {"type": "array", "items": {"type": "string"}},
          "exitCode": {"const": 0}
        }
      }
    },
    "result": {"const": "passed"}
  }
}
