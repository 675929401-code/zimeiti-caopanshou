{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zimeiti.local/contracts/release-acceptance-trusted-issuers.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "trustRoot", "maxEvidenceAgeSeconds", "issuers"],
  "properties": {
    "schemaVersion": {"const": "zimeiti-release-acceptance-trusted-issuers.v1"},
    "projectId": {"const": "zimeiti-caopanshou"},
    "trustRoot": {
      "type": "object", "additionalProperties": false,
      "required": ["rootId", "custody", "keyMaterial"],
      "properties": {
        "rootId": {"const": "zimeiti-release-acceptance-external-root-v1"},
        "custody": {"const": "external-controlled"},
        "keyMaterial": {"const": "public-only"}
      }
    },
    "maxEvidenceAgeSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "issuers": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issuerId", "trustRootId", "publicKeyPem", "publicKeyFingerprint", "allowedEvidenceTypes"],
        "properties": {
          "issuerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"},
          "trustRootId": {"const": "zimeiti-release-acceptance-external-root-v1"},
          "publicKeyPem": {"type": "string", "minLength": 40},
          "publicKeyFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "allowedEvidenceTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "release-browser-acceptance"}}
        }
      }
    }
  }
}
