{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zimeiti.local/contracts/release-secret-exposure-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifier", "mode", "status", "scopeReceiptId", "scopeReceiptSha256", "candidate", "outputPolicy", "summary", "workingTree", "gitHistory"],
  "properties": {
    "schemaVersion": {"const": "zimeiti-release-secret-exposure-receipt.v1"},
    "verifier": {"const": "release-secret-exposure"},
    "mode": {"enum": ["release-candidate", "local-evidence"]},
    "status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]},
    "scopeReceiptId": {"type": ["string", "null"], "pattern": "^scope-[a-f0-9]{24}$"},
    "scopeReceiptSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["commit", "cleanRequired"],
      "properties": {"commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "cleanRequired": {"type": "boolean"}}
    },
    "outputPolicy": {"const": "paths-categories-counts-only"},
    "summary": {"type": "object"},
    "workingTree": {"type": "object"},
    "gitHistory": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "base", "head", "includeBase", "commits", "findings"],
      "properties": {
        "available": {"const": true},
        "base": {"type": ["string", "null"]},
        "head": {"type": ["string", "null"]},
        "includeBase": {"type": "boolean"},
        "commits": {"type": "integer", "minimum": 0},
        "findings": {"type": "array"}
      }
    }
  }
}
