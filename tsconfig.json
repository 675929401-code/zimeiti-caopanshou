{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-validation/types/**/*.ts",
    ".next-validation/dev/types/**/*.ts",
    ".next-local-acceptance/types/**/*.ts",
    ".next-local-acceptance/dev/types/**/*.ts",
    ".next-local-acceptance-next/types/**/*.ts",
    ".next-local-acceptance-next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts/billing-baseline",
    "main-site",
    "voice-studio",
    "docs",
    "backups",
    "项目备份",
    "voice-platform",
    "自媒体操盘手",
    "wangzhanbeifen",
    "任务快照",
    "snapshots",
    ".codex-backups",
    ".codex-evidence"
  ]
}
