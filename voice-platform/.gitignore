node_modules/
.pnp
.pnp.js

# 构建输出
.next/
out/
build/
dist/

# 环境变量可能包含运行凭据，.env* 绝不提交；仅保留无凭据模板。
.env*
!.env.example

# 运行数据库及 WAL/SHM/journal 边车属于可变数据，绝不提交。
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# IDE
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 缓存
.cache/
.turbo/
.eslintcache

# 临时文件
*.tmp
*.bak

# TypeScript构建缓存
*.tsbuildinfo

# 调试截图
scripts/*.png

# Generated-only 头像边界：仅以下两个生成脚本、生成 API 与生成图片不属于发布源码。
# 不得把此边界扩大到其他 scripts/、src/ 或 public/ 路径。
scripts/batch-gen-avatars.sh
scripts/generate-avatars.py
public/avatars/
src/app/api/avatars/

# 用户参考音频本地缓存（运行时保存，不提交）
public/reference-audio/
nul
