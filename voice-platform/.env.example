# ===========================================
# 语音工坊 - 环境变量配置（复制此文件为 .env 并填写实际值）
# ===========================================

# --- 火山引擎 TTS API ---
VOLCENGINE_API_KEY_1=
VOLCENGINE_API_KEY_2=
VOLCENGINE_API_BASE=

# --- 运维脚本与链接解析 ---
VOLCENGINE_API_KEY=
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY_B64=
PPT6_CLIENT_ID=
PPT6_CLIENT_SECRET=

# --- 主站对接密钥 ---
# 主站调用充值接口时需在 Header 中携带此密钥。
# 必须与受保护的服务器环境变量 SITE_API_KEY 保持一致；禁止提交真实值。
SITE_API_KEY=

# --- 用户认证密钥 ---
# JWT 签名密钥，生产环境必须使用密码管理器生成并注入，禁止提交真实值。
AUTH_SECRET=

# --- 数据库 ---
# 当前 schema 是 SQLite。本地相对路径以 prisma/schema.prisma 所在目录解析。
# vNext 生产由 PM2/Secret 环境注入 file:/srv/.../shared/voice/voice.db，数据库
# 位于不可变制品之外。未来迁移 PostgreSQL 必须走独立 schema/migration 项目，
# 不能只替换连接串。
DATABASE_URL="file:./dev.db"
VOICE_SQLITE_PATH=
# Production must point outside the immutable release directory.
VOICE_REFERENCE_AUDIO_DIR=/srv/zimeiti-caopanshou/shared/voice/reference-audio

# --- 不可变发布身份（由部署器注入，禁止手工伪造）---
COZE_PROJECT_ENV=PROD
RELEASE_ROOT=/srv/zimeiti-caopanshou
RELEASE_ID=
DEPLOY_COMMIT_SHA=
