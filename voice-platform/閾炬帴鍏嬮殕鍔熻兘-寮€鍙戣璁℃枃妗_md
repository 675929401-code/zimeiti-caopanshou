## 四、API设计

### 4.1 新建 API：`POST /api/voice/link-clone`

```typescript
// 请求体
{
  "url": "https://v.douyin.com/xxxxx",     // 短视频分享链接（必填）
  "name": "科普大叔",                       // 克隆音色名称（可选，默认取视频标题）
  "userId": "cm8p0wfes0001qvgk7h4y9ojp",  // 用户ID（主站传入）
  "duration": 20                            // 截取秒数（可选，默认20，范围14-30）
}

// 成功响应
{
  "success": true,
  "data": {
    "speakerId": "S_1755323888777",
    "videoTitle": "量子力学入门：薛定谔的猫",
    "videoCover": "https://...",
    "status": 1,                      // 0=排队,1=训练中,2=成功,3=失败
    "message": "链接克隆已提交，预计2-5分钟完成"
  }
}

// 错误响应
{
  "success": false,
  "message": "链接解析失败：该平台暂不支持",
  "code": "LINK_PARSE_ERROR"
}
```

### 4.2 处理流程（route.ts 核心逻辑）

```typescript
export async function POST(request: NextRequest) {
  // 1. 认证（支持 JWT + X-Site-API-Key 双模式）
  const userId = await authenticate(request);
  
  // 2. 参数校验
  const { url, name, duration = 20 } = await request.json();
  if (!url) return errorResponse('请输入视频链接');
  if (duration < 14 || duration > 30) return errorResponse('时长范围为14-30秒');
  
  // 3. 解析链接 → 获取视频直链
  const videoInfo = await extractVideoUrl(url);
  if (!videoInfo.videoUrl) return errorResponse('链接解析失败');
  
  // 4. MP4→MP3 转换
  const mp3Url = await convertVideoToMp3(videoInfo.videoUrl);
  if (!mp3Url) return errorResponse('音频提取失败');
  
  // 5. 下载 + 预处理（ffmpeg 截取+转换）
  const wavBase64 = await downloadAndProcess(mp3Url, duration);
  if (!wavBase64) return errorResponse('音频处理失败');
  
  // 6. 调用火山引擎声音复刻（复用现有 cloneVoice）
  const speakerId = `S_${Date.now()}`;
  const result = await cloneVoice({
    speakerId,
    audioBase64: wavBase64,
    audioFormat: 'wav',
    language: 0,
  });
  
  // 7. 创建数据库记录
  await prisma.voice.create({
    data: {
      speakerId,
      name: name || videoInfo.title || `链接克隆_${Date.now()}`,
      type: 'cloned',
      category: 'custom',
      language: 'zh-cn',
      isActive: true,
      userId,
    },
  });
  
  // 8. 扣费
  if (userId) {
    await deductBalance(userId, 0, `clone-${speakerId}`, '链接克隆');
  }
  
  return successResponse({ speakerId, videoTitle: videoInfo.title, status: result.status });
}
```

