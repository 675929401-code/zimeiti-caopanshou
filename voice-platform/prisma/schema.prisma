generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String?
  password         String
  role             String        @default("user")
  balance          Float         @default(0)    // 用户余额（元）
  storageConfigured Boolean      @default(false) // 是否已配置存储
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  favorites        Favorite[]
  ttsJobs          TTSJob[]
  voices           Voice[]       // 用户创建的音色(复刻/设计)
  transactions     Transaction[] // 交易记录
}

model Voice {
  id            String     @id @default(cuid())
  speakerId     String     @unique
  name          String
  description   String?
  type          String     @default("official") // official/cloned/designed
  category      String
  tags          String     @default("[]")
  language      String     @default("zh-cn")
  gender        String?
  avatar        String?
  isActive      Boolean    @default(true)
  isRecommended Boolean    @default(false) // 管理员推荐的优质音色
  userId        String?    // 创建者(复刻/设计音色)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User?      @relation(fields: [userId], references: [id])
  favorites     Favorite[]
  ttsJobs       TTSJob[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  voiceId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  voice     Voice    @relation(fields: [voiceId], references: [id])
  @@unique([userId, voiceId])
}

model TTSJob {
  id          String    @id @default(cuid())
  userId      String?
  voiceId     String?
  text        String
  model       String    @default("seed-tts-2.0")
  mode        String?   // single/dual 单人/双人对话模式
  params      String?
  status      String    @default("pending")
  audioUrl    String?
  duration    Float?
  tokensUsed  Int?
  charCount   Int?      // 文本字符数
  cost        Float?    // 本次合成费用（元）
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  user        User?     @relation(fields: [userId], references: [id])
  voice       Voice?    @relation(fields: [voiceId], references: [id])
}

model ApiConfig {
  id            String   @id @default(cuid())
  name          String
  apiKey        String
  resourceId    String   @default("seed-tts-2.0")
  costPricePer1k Float   @default(0.5)  // 每千字符成本价（元）
  profitMargin  Float    @default(100)  // 利润率（%，100=翻倍）
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 交易记录（充值/扣费）
// 模型配置（每个模型独立卡片：密钥/成本价/利率/计费单位）
model ModelConfig {
  id            String   @id @default(cuid())
  name          String           // 显示名称，如"语音合成 2.0"
  modelId       String   @unique // API模型ID，如 seed-tts-2.0
  resourceId    String   @default("seed-tts-2.0") // 资源ID
  apiKey        String?          // API密钥（留空用.env默认值）
  totalPrice    Float    @default(28)   // 火山引擎套餐总价（元），如¥28
  totalChars    Int      @default(100000) // 套餐总字数，如10万
  costPrice     Float    @default(0.28) // 自动计算：总价÷总字数×单位基数
  unit          String   @default("千字符") // 计费单位：千字符/次
  profitMargin  Float    @default(100) // 利润率（%）
  isActive      Boolean  @default(true)
  sort          Int      @default(0) // 排序
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // charge(充值) / deduct(扣费) / refund(退款)
  amount      Float    // 金额（元），正数
  balance     Float?   // 交易后余额
  description String?  // 描述
  jobId       String?  // 关联的TTS任务ID
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// 授权密钥（音色槽位：138元/个，15次训练）
model CloneLicense {
  id            String   @id @default(cuid())
  licenseKey    String   @unique           // 密钥文本，如 ZY-XXXX-XXXX
  status        String   @default("active") // active(可用) / expired(到期) / exhausted(用完)
  assignedTo    String?                     // 绑定的用户标识
  speakerId     String?                     // 绑定的音色ID（复刻/设计产出）
  maxTrainings  Int      @default(15)       // 最大训练次数
  usedTrainings Int      @default(0)        // 已使用次数
  createdAt     DateTime @default(now())
  usedAt        DateTime?
  updatedAt     DateTime @updatedAt
}
