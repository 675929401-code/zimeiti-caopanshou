    "migrationSemanticAdoptCommand": "node scripts/db-migration-release.mjs adopt --semantic-receipt=<receipt-path> --confirm-semantic-receipt-sha256=<receipt-sha256> --confirm-target-fingerprint=<target-fingerprint> --confirm-target-host=<database-host> --confirm-manifest-sha256=<plan-manifest-sha256> --confirm-backup=<backup-receipt-or-path>",
    "migrationSemanticCheckVersion": "catalog-and-transaction-noop.v2",
    "migrationPendingSemanticVerification": "scripts/verify-pending-migration-semantics.mjs",
    "migrationPendingSemanticCheckCommand": "node scripts/verify-pending-migration-semantics.mjs --write-evidence",
    "migrationPendingSemanticCheckVersion": "pending-migration-object-coverage.v1",
    "migrationPendingSemanticReconciliation": {
      "forwardMigration": "20260904031000_reconcile_pending_legacy_semantics.sql",
      "executionMode": "separate-reviewed-forward-only",
      "requires": [
        "pre-migration database backup receipt",
        "confirmed loopback target fingerprint for local rehearsal",
        "reviewed current impact counts",
        "explicit application authorization"
      ],
      "legacyAdoptionRule": "all-nine-profiles-must-pass-after-reconciliation-before-ledger-adoption",
      "evidencedAdoptionTool": "scripts/adopt-evidenced-migrations.mjs",
      "evidencedAdoptionExecution": "explicit-execute-flag-after-successful-no-write-plan",
      "evidencedAdoptionRules": [
        "exact pending set",
        "zero migration hash drift",
        "live 9-of-9 semantic recheck",
        "live 0255 function body and permission recheck",
        "confirmed backup archive and receipt hashes",
        "confirmed single-file 0310 application receipt",
        "migration SQL replay forbidden",
        "single advisory-locked ledger transaction"
      ]
    },
    "migrationApplyCommand": "pnpm deploy:db:apply -- --confirm-target-host=<database-host> --confirm-manifest-sha256=<plan-manifest-sha256> --confirm-backup=<backup-receipt-or-path>",
    "migrationDatabaseUrlEnv": ["DEPLOY_DATABASE_URL", "SUPABASE_DATABASE_URL", "DATABASE_URL", "POSTGRES_URL"],
    "migrationApplyConfirmations": ["--confirm-target-host", "--confirm-manifest-sha256", "--confirm-backup"],
    "applicationManagedMigrationsAllowed": false,
    "preMigrationBackupRequired": true,
    "freshBootstrapStatus": "baseline-schema-not-yet-captured",
    "freshBootstrapRequiredBeforeDisasterRecoverySignoff": true
