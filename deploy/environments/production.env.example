# 自媒体操盘手生产环境变量模板
# 复制到本机私有位置或 CI/服务器 Secret 面板后填写；不要把填写后的文件提交到 Git。
# 所有包含密码、token、access key、private key 的值都不能发到聊天、截图或日志里。

# 1) Git 发布仓接入
# 主仓推荐 Gitee 私有仓；备份推荐 CODING/GitHub/GitLab 等独立私有仓。
RELEASE_ORIGIN_URL=git@gitee.com:<account>/zimeiti-caopanshou-source-vnext.git
RELEASE_BACKUP_URL=git@e.coding.net:<team>/<project>/zimeiti-caopanshou-source-vnext-backup.git

# 2) 数据库迁移
# 真实值形如 postgresql://user:password@host:5432/database?sslmode=require
# 只放在本机环境变量、CI Secret 或服务器 Secret；不要提交、不要发聊天。
DEPLOY_DATABASE_URL=

# 3) 服务器部署目标
# 推荐以后使用 deploy 用户；如果现阶段只能 root，也必须限定部署根目录，不能覆盖 shared。
DEPLOY_SSH_TARGET=deploy@134.175.87.247
DEPLOY_SSH_PORT=22
DEPLOY_RELEASE_ROOT=/data/web
DEPLOY_INCOMING_DIR=/data/direct-deploy/incoming

# 4) 服务器运行时目录
RELEASE_ROOT=/data/web
APP_DATA_DIR=/data/web/shared/data
APP_RUNTIME_DIR=/data/web/shared/runtime
COMMERCE_DATA_DIR=/data/web/shared/runtime/commerce-agent
COMMERCE_DISCOVERY_CATALOG=/data/web/shared/runtime/commerce-discovery/catalog.json
COMMERCE_GATEWAY_KEY_FILE=/data/web/shared/runtime/commerce-agent/main-gateway.key
IDEMPOTENCY_DIR=/data/web/shared/runtime/llm-request-idempotency
BACKUP_DIR=/data/web/shared/backups
STORAGE_LOCAL_BASE_PATH=/data/web/shared/uploads
PUBLIC_ASSET_ROOT=/data/web/shared/assets/current/public
VOICE_SQLITE_PATH=/data/web/shared/voice/voice.db
VOICE_DATABASE_URL=file:/data/web/shared/voice/voice.db
VOICE_REFERENCE_AUDIO_DIR=/data/web/shared/voice/reference-audio

# 4.1) 上游提交并发保护（当前为同一主机跨 PM2 进程共享；多主机需外置协调存储）
# 默认值按 global/provider/channel/model = 8/6/3/2。只有压测证据支持时才提高。
PROVIDER_ADMISSION_GLOBAL_LIMIT=8
PROVIDER_ADMISSION_PROVIDER_LIMIT=6
PROVIDER_ADMISSION_CHANNEL_LIMIT=3
PROVIDER_ADMISSION_MODEL_LIMIT=2
PROVIDER_ADMISSION_TTL_MS=600000

# 5) 素材发布策略
# 初次上线先用 disk，稳定后迁 COS/CDN；启用 cos 前必须通过 Range/CORS/缓存/回滚验收。
ASSET_DELIVERY_MODE=disk
ASSET_STORAGE_DRIVER=disk
COS_BUCKET=
COS_REGION=
COS_CDN_BASE_URL=
COS_PUBLIC_ASSET_PREFIX=assets/releases
# Enable only after deploy/policies/media-object-retention.v2.json is applied and read back from COS.
NEXT_PUBLIC_MEDIA_RETENTION_ENFORCED=false

# 6) 应用身份
NODE_ENV=production
COZE_PROJECT_ENV=PROD
# 贴牌客户域名验证通过后配置的统一 CNAME 网关目标；不得填写客户自己的域名。
WHITE_LABEL_CNAME_TARGET=

# 7) 内部健康巡检
# 至少32位随机值，由服务器 Secret 管理；调度器只通过请求头传递，禁止放入 URL。
HEALTH_CHECK_SECRET=
