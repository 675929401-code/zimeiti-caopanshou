# Realtime database (required)
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# Authentication (required, keep identical across releases)
JWT_SECRET=

# Internal health monitor authentication. Generate at least 32 random
# characters in the deployment secret manager; never put it in a URL.
HEALTH_CHECK_SECRET=

# Default language and vision providers
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=
VISION_API_BASE_URL=
VISION_API_KEY=

# Voice link parser (server-only; required by voice-platform link-clone route)
PPT6_CLIENT_ID=
PPT6_CLIENT_SECRET=
VISION_MODEL=

# Optional providers
ARK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
VOLC_TOKEN=

# Object storage
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
STORAGE_DEFAULT_PROVIDER=tencent_cos
STORAGE_FALLBACK_PROVIDER=local
# Only set true after every COS media lifecycle prefix is applied and read back.
NEXT_PUBLIC_MEDIA_RETENTION_ENFORCED=false

# Email
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# Deployment verification
BASE_URL=http://127.0.0.1:5000
VERIFY_AUTH_TOKEN=
# Immutable release runtime boundaries. Production must use absolute persistent
# paths outside releases/<release-id>; PM2 vNext supplies these defaults.
COZE_PROJECT_ENV=PROD
RELEASE_ROOT=/srv/zimeiti-caopanshou
RELEASE_ID=
DEPLOY_COMMIT_SHA=
APP_DATA_DIR=/srv/zimeiti-caopanshou/shared/data
APP_RUNTIME_DIR=/srv/zimeiti-caopanshou/shared/runtime
COMMERCE_DATA_DIR=/srv/zimeiti-caopanshou/shared/runtime/commerce-agent
COMMERCE_DISCOVERY_CATALOG=/srv/zimeiti-caopanshou/shared/runtime/commerce-discovery/catalog.json
COMMERCE_GATEWAY_KEY_FILE=/srv/zimeiti-caopanshou/shared/runtime/commerce-agent/main-gateway.key
IDEMPOTENCY_DIR=/srv/zimeiti-caopanshou/shared/runtime/llm-request-idempotency
BACKUP_DIR=/srv/zimeiti-caopanshou/shared/backups
STORAGE_LOCAL_BASE_PATH=/srv/zimeiti-caopanshou/shared/uploads
PUBLIC_ASSET_ROOT=/srv/zimeiti-caopanshou/shared/assets/current/public
ASSET_DIGEST=
ASSET_MANIFEST_SHA256=
ASSET_DELIVERY_MODE=disk
VOICE_REFERENCE_AUDIO_DIR=/srv/zimeiti-caopanshou/shared/voice/reference-audio
# Web admin/pricing and Voice Platform must point to the same persistent DB.
# Local development may omit this and use voice-platform/prisma/dev.db.
# Production must inject an absolute path outside every immutable release.
VOICE_SQLITE_PATH=
VOICE_DATABASE_URL=
# 服务器部署时可指定系统 Chromium；Dockerfile 已默认配置。
# Windows/macOS 本地开发通常无需填写，Playwright 会使用自己的浏览器。
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# AutoDL.Art 托管 ComfyUI H3（优先挂载 chmod 0400/0600 的服务器密钥文件）
AUTODL_COMFYUI_API_KEY_FILE=/run/secrets/autodl-comfyui-api-key
# 仅在无法挂载密钥文件时使用环境变量回退；绝对不要改成 NEXT_PUBLIC_*
AUTODL_COMFYUI_API_KEY=

# AutoDL H3 自租实例生产控制平面（默认关闭，完成密钥/SSH/实例验证后再切换三个开关）
AUTODL_H3_LIFECYCLE_ENABLED=false
AUTODL_H3_LIFECYCLE_DRY_RUN=true
AUTODL_H3_LIFECYCLE_ALLOW_POWER_ACTIONS=false
AUTODL_H3_ATOMIC_FINALIZER_ENABLED=false
AUTODL_H3_INSTANCE_UUID=
AUTODL_H3_IDLE_SECONDS=300
AUTODL_H3_WORKER_INTERVAL_MS=5000

# Developer Token 与 H3 网关令牌由部署服务器/容器 secret 提供，不依赖 Codex、GUI 或 DPAPI
AUTODL_DEVELOPER_TOKEN_FILE=/run/secrets/autodl-developer-token
AUTODL_H3_SELFHOST_API_KEY_FILE=/run/secrets/autodl-h3-selfhost-api-key
# 仅作紧急环境变量回退，正常部署留空
AUTODL_DEVELOPER_TOKEN=
AUTODL_H3_SELFHOST_API_KEY=

# 部署服务器自有 SSH 转发：127.0.0.1:16011 -> snapshot SSH -> 127.0.0.1:6011
AUTODL_H3_SSH_EXECUTABLE=/usr/bin/ssh
AUTODL_H3_SSH_KEY_PATH=/run/secrets/autodl-h3-ssh-key
AUTODL_H3_SSH_KNOWN_HOSTS_PATH=/etc/agent-hub/autodl-h3-known-hosts
# known_hosts 必须用这个固定别名锁定已核验的主机公钥，使 snapshot 端口变更时仍严格验证
AUTODL_H3_SSH_HOST_KEY_ALIAS=autodl-h3-production
# Browser conversation-body caching is permanently retired; history is loaded from the authenticated server API.
