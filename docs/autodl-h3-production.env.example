# AutoDL H3 production controller — safe template only.
# Copy the required keys into /data/agent-hub/env/.env.local on the deployment
# server. Never commit the real file. All credential fields below are blank on
# purpose; do not prefix any of them with NEXT_PUBLIC_.

# Existing server-side database connection used by the lifecycle lease/fencing
# store. The service-role key is required for the lifecycle RPCs.
COZE_SUPABASE_URL=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# Safe default: installation remains completely disabled until the staged
# activation checklist in the deployment runbook has been completed.
AUTODL_H3_LIFECYCLE_ENABLED=false
AUTODL_H3_INSTANCE_UUID=

# Control-plane Developer Token and data-plane gateway Bearer key. Production
# prefers root/service-user-only files (0400/0600). Docker may instead keep the
# same names under /run/secrets; the runtime also checks those fixed defaults.
AUTODL_DEVELOPER_TOKEN_FILE=/data/agent-hub/secrets/autodl-h3/developer.token
AUTODL_H3_SELFHOST_API_KEY_FILE=/data/agent-hub/secrets/autodl-h3/gateway.token
# Emergency environment fallback only. Keep blank when *_FILE is configured.
AUTODL_DEVELOPER_TOKEN=
AUTODL_H3_SELFHOST_API_KEY=

# Absolute paths on the Linux deployment server. The private key must be a
# regular file with no group/other permission bits (normally mode 0600).
AUTODL_H3_SSH_EXECUTABLE=/usr/bin/ssh
AUTODL_H3_SSH_KEY_PATH=/data/agent-hub/secrets/autodl-h3/id_ed25519
AUTODL_H3_SSH_KNOWN_HOSTS_PATH=/data/agent-hub/secrets/autodl-h3/known_hosts
# known_hosts must pin the verified key under this stable alias. The alias lets
# an official snapshot change proxy_host/ssh_port without weakening host-key
# verification or requiring an automatic ssh-keyscan trust step.
AUTODL_H3_SSH_HOST_KEY_ALIAS=autodl-h3-production

# Stage 1 (observation): enabled=true, dry-run=true, power-actions=false.
# Stage 2 (active): enabled=true, dry-run=false, atomic-finalizer=true,
# power-actions=true. Never enable power actions without the atomic finalizer.
AUTODL_H3_LIFECYCLE_DRY_RUN=true
AUTODL_H3_LIFECYCLE_ALLOW_POWER_ACTIONS=false
AUTODL_H3_ATOMIC_FINALIZER_ENABLED=false

# Conservative controller defaults. Idle shutdown cannot be configured below
# 300 seconds by the runtime.
AUTODL_H3_LIFECYCLE_LEASE_SECONDS=30
AUTODL_H3_IDLE_SECONDS=300
AUTODL_H3_RETRY_SECONDS=30
AUTODL_H3_MAX_DISPATCH_ATTEMPTS=3
AUTODL_H3_STARTUP_DEADLINE_SECONDS=720
AUTODL_H3_POWER_ACTION_DEADLINE_SECONDS=180
AUTODL_H3_WORKER_INTERVAL_MS=5000
